{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "ES2022"],
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["packages/shared/src/*"],
      "@infra/db": ["infra/db/src/index.ts"],
      "@character": ["packages/character/src/profile.ts"],
      "@world/daily-life": ["packages/world/src/daily-life/ledger.ts"],
      "@world/stories": ["packages/world/src/stories/goals.ts"],
      "@world/npc": ["packages/world/src/npc/profiles.ts"],
      "@world/emotion": ["packages/world/src/emotion/state.ts"],
      "@world/lore": ["packages/world/src/lore/facts.ts"],
      "@people/users": ["packages/people/src/users.ts"],
      "@people/identity": ["packages/people/src/identity.ts"],
      "@people/relationship": ["packages/people/src/relationship.ts"],
      "@people/commitments": ["packages/people/src/commitments.ts"],
      "@memory": ["packages/memory/src/memory.ts"],
      "@proactive": ["packages/proactive/src/schedule.ts"],
      "@prompting": ["packages/prompting/src/compile.ts"],
      "@prompting/guard": ["packages/prompting/src/guard.ts"],
      "@model": ["packages/model/src/deepseek.ts"],
      "@core/conversation": ["packages/core/src/conversation/turn.ts"],
      "@core/aggregate": ["packages/core/src/conversation/aggregate.ts"],
      "@core/context": ["packages/core/src/context/build.ts"],
      "@core/social": ["packages/core/src/social/policy.ts"],
      "@core/delivery": ["packages/core/src/delivery/outbox.ts"],
      "@core/jobs": ["packages/core/src/jobs/queue.ts"],
      "@channels/external": ["packages/channels/src/external-events.ts"],
      "@channels/qq": ["packages/channels/src/qq/main.ts"],
      "@evaluation": ["packages/evaluation/src/checks.ts"],
      "@evaluation/simulation": ["packages/evaluation/src/simulation.ts"],
      "@gateway": ["apps/gateway/src/handle.ts"],
      "@worker/loop": ["apps/worker/src/loop.ts"]
    }
  },
  "include": ["apps/**/*.ts", "apps/**/*.tsx", "packages/**/*.ts", "infra/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
